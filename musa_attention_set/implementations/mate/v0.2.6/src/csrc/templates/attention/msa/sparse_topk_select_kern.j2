#include <cstdint>

#include <musa_runtime.h>

#include "mate/attention/msa/kernel/sparse_topk_select.hpp"
#include "op_utils.hpp"

void sparse_topk_select(
    ffi::TensorView max_score,
    ffi::TensorView output_indices,
    int64_t topk,
    int64_t num_valid_pages,
    int64_t force_begin_blocks,
    int64_t force_end_blocks,
    bool force_blocks_count_in_topk,
    ffi::Optional<ffi::TensorView> query_positions) {
  CHECK_MUSA(max_score);
  CHECK_MUSA(output_indices);
  CHECK_DIM(3, max_score);
  CHECK_DIM(3, output_indices);
  CHECK_INPUT_TYPE(max_score, dl_float32);
  CHECK_INPUT_TYPE(output_indices, dl_int32);
  CHECK_CONTIGUOUS(max_score);
  CHECK_CONTIGUOUS(output_indices);
  CHECK_DEVICE(output_indices, max_score);

  ffi::MUSADeviceGuard device_guard(max_score.device().device_id);

  int total_q = static_cast<int>(max_score.size(0));
  int num_qo_heads = static_cast<int>(max_score.size(1));
  int max_k_tiles = static_cast<int>(max_score.size(2));

  TVM_FFI_ICHECK(mate::attention::msa::sparse_topk::is_supported_topk(static_cast<uint32_t>(topk)))
      << "MSA sparse_topk_select only supports topk in {4, 8, 16}, got " << topk;
  TVM_FFI_ICHECK_GT(num_qo_heads, 0);
  TVM_FFI_ICHECK_GE(total_q, 0);
  TVM_FFI_ICHECK_GT(max_k_tiles, 0);
  TVM_FFI_ICHECK_GT(num_valid_pages, 0);
  TVM_FFI_ICHECK_LE(num_valid_pages, max_k_tiles);
  TVM_FFI_ICHECK_GE(force_begin_blocks, 0);
  TVM_FFI_ICHECK_GE(force_end_blocks, 0);
  if (force_blocks_count_in_topk) {
    TVM_FFI_ICHECK_LE(force_begin_blocks + force_end_blocks, topk);
  }
  const int64_t output_width = force_blocks_count_in_topk
                                   ? topk
                                   : topk + force_begin_blocks + force_end_blocks;
  TVM_FFI_ICHECK_LE(output_width, mate::attention::msa::sparse_topk::kSparseTopkMaxK);
  TVM_FFI_ICHECK_EQ(output_indices.size(0), total_q);
  TVM_FFI_ICHECK_EQ(output_indices.size(1), num_qo_heads);
  TVM_FFI_ICHECK_EQ(output_indices.size(2), output_width);

  int64_t const* query_positions_ptr = nullptr;
  if (query_positions.has_value()) {
    auto positions = query_positions.value();
    CHECK_MUSA(positions);
    CHECK_DIM(1, positions);
    CHECK_INPUT_TYPE(positions, dl_int64);
    CHECK_CONTIGUOUS(positions);
    CHECK_DEVICE(positions, max_score);
    TVM_FFI_ICHECK_EQ(positions.size(0), total_q)
        << "query_positions must have shape [total_q]";
    query_positions_ptr = static_cast<int64_t const*>(positions.data_ptr());
  }

  if (total_q == 0) {
    return;
  }

  musaStream_t stream = get_stream(max_score.device());
  musaError_t status = mate::attention::msa::sparse_topk::launch_sparse_topk_select(
      static_cast<float const*>(max_score.data_ptr()),
      static_cast<int32_t*>(output_indices.data_ptr()),
      static_cast<uint32_t>(total_q),
      static_cast<uint32_t>(num_qo_heads),
      static_cast<uint32_t>(max_k_tiles),
      static_cast<uint32_t>(topk),
      static_cast<uint32_t>(num_valid_pages),
      query_positions_ptr,
      static_cast<uint32_t>(force_begin_blocks),
      static_cast<uint32_t>(force_end_blocks),
      force_blocks_count_in_topk,
      stream);
  TVM_FFI_ICHECK(status == musaSuccess)
      << "sparse_topk_select failed: " << musaGetErrorString(status);
}

TVM_FFI_DLL_EXPORT_TYPED_FUNC(sparse_topk_select, sparse_topk_select);
